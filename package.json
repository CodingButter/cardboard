{
  "name": "two_5_d",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run dev:editor & bun run dev:game & wait",
    "dev:game": "cd apps/game && bun run dev",
    "dev:editor": "cd apps/editor && bun run dev",
    "docs:dev": "cd apps/docs && bun run dev",
    "docs:build": "cd apps/docs && bun run build",
    "build:game-for-docs": "bun scripts/build-game-for-docs.ts",
    "build:editor-for-docs": "bun scripts/build-editor-for-docs.ts",
    "build": "cd apps/game && bun run build",
    "build-packs": "cd apps/pack-builder && bun run build-packs",
    "generate-scene": "cd apps/pack-builder && bun run generate-scene",
    "make-icons": "cd apps/pack-builder && bun run make-icons",
    "kill": "cd apps/pack-builder && bun run kill",
    "typecheck": "cd packages/shared && bun run typecheck && cd ../engine && bun run typecheck && cd ../../apps/game && bun run typecheck && cd ../pack-builder && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.8.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
