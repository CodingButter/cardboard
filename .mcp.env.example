# Environment variables required by .mcp.json
#
# Copy this file to .env (or export the vars in your shell rc) and
# fill in the values. The .mcp.json config uses ${VAR_NAME} substitution
# to inject these without committing secrets.
#
# This file IS committed; .env is gitignored.

# Bearer token for the voice MCP server at http://tts.codingbutter.com/mcp
# Ask the project owner for the value if you don't have it.
VOICE_BEARER_TOKEN=replace-me-with-real-token
