# dependencies (bun install)
node_modules

# output
out
dist
*.tgz

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# Pack-builder publish-mode local config (see apps/pack-builder/.env.example
# and docs/plans/PUBLISH_SETTINGS.md). The example file IS committed.
apps/pack-builder/.env

# caches
.eslintcache
.cache
*.tsbuildinfo

# IntelliJ based IDEs
.idea

# Finder (MacOS) folder config
.DS_Store

# .mcp.json — NOT ignored anymore. Bearer tokens were extracted to
# ${VOICE_BEARER_TOKEN} env substitution so the file is commit-safe.
# Set the env var in your shell rc or a .env file (see .mcp.env.example).

# Claude Code per-machine state — selectively ignored so the project-
# scoped pieces (memory, settings, commands, agents) stay committed and
# travel with the repo.
.claude/screenshots/
.claude/worktrees/
.claude/*.local.json
.claude/settings.local.json

# WAD files — id Software proprietary binary assets, fetched/dropped locally
apps/game/public/wads/*.wad
apps/game/public/wads/*.WAD

# Generated pack component type declarations — emitted by
# `bun run build-packs` per-pack into `packages/*/types/pack.d.ts`.
# The file is a tsc-only artefact (does NOT ship in the .apg) and
# regenerates deterministically from `manifest.components`.
packages/*/types/

# Playwright MCP screenshot debris
.playwright-mcp/

# Local screenshot scratchpad
screenshots/
=
