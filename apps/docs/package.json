{
  "name": "@two_5_d/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "bun run sync:plans && bun run gen:api && bun run stage:game && bun run stage:editor",
    "stage:game": "bun ../../scripts/build-game-for-docs.ts",
    "stage:editor": "bun ../../scripts/build-editor-for-docs.ts",
    "build": "next build --webpack",
    "dev": "next dev",
    "start": "serve out",
    "sync:plans": "bun ../../scripts/sync-plans.ts",
    "gen:api": "bun ../../scripts/gen-api-docs.ts",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "fumadocs-core": "16.8.11",
    "fumadocs-mdx": "15.0.4",
    "fumadocs-ui": "16.8.11",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.14",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.0",
    "typedoc": "^0.28.5",
    "typedoc-plugin-markdown": "^4.4.0",
    "typescript": "^6.0.3"
  }
}
