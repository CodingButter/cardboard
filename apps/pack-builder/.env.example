# Pack-builder publish settings. Bun reads .env automatically.
# Copy this to apps/pack-builder/.env to override.

# 'development' or 'production'. Defaults to 'development'.
# development → no optimization, fast builds, pass-through.
# production  → optimize via sharp + ffmpeg per the knobs below.
PUBLISH_MODE=development

# ─── Individual images (sprites, item icons, single-tile textures, app icons) ───
IMAGE_MAX_DIMENSION=1024     # px; downscales larger; aspect preserved
IMAGE_JPEG_QUALITY=85        # 1-100
IMAGE_PNG_QUANTIZE=true      # palette quantization

# ─── Tilesheets (manifest.tileSheets[] images) — pixel dimensions NEVER changed ───
TILESHEET_JPEG_QUALITY=90
TILESHEET_PNG_QUANTIZE=false

# ─── Audio (production only) ───
AUDIO_BITRATE=128k
AUDIO_SAMPLE_RATE=44100
