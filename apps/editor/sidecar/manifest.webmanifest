{
  "name": "Cardboard SideCar",
  "short_name": "SideCar",
  "description": "Remote dock surface for the Cardboard editor — pair a phone or tablet via QR.",
  "scope": "./",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#0a0a0c",
  "theme_color": "#1a1814",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "../icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "../icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
