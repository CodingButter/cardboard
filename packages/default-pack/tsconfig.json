{
  // tsconfig for the default content pack. Bun executes pack scripts
  // (`scripts/**/*.js`, `.ts`, `.tsx`) at pack-build time via Bun's
  // bundler — this tsconfig exists purely so `tsc --noEmit` can
  // typecheck the scripts against the generated `types/pack.d.ts`
  // (declaration-merged `PackComponents`) and the engine's public
  // surface.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@two_5_d/engine": ["../engine/src/index.ts"],
      "@two_5_d/engine/*": ["../engine/src/*"],
      // Engine intra-package bare-name aliases — must be reachable
      // because importing `@two_5_d/engine` pulls in source files
      // whose own imports use these aliases. Keep in sync with
      // `packages/engine/tsconfig.json`.
      "AssetPack": ["../engine/src/AssetPack/index.ts"],
      "AssetPack/*": ["../engine/src/AssetPack/*"],
      "Components": ["../engine/src/Components/index.ts"],
      "Components/*": ["../engine/src/Components/*"],
      "Config": ["../engine/src/Config.ts"],
      "Controllers": ["../engine/src/Controllers/index.ts"],
      "Controllers/*": ["../engine/src/Controllers/*"],
      "ECS": ["../engine/src/ECS/index.ts"],
      "ECS/*": ["../engine/src/ECS/*"],
      "Engine": ["../engine/src/Engine.ts"],
      "Game": ["../engine/src/Game.ts"],
      "GameConfig": ["../engine/src/GameConfig.ts"],
      "ItemImages": ["../engine/src/ItemImages.ts"],
      "Libs/*": ["../engine/src/Libs/*"],
      "ModalRegistry": ["../engine/src/ModalRegistry.ts"],
      "ModAPI": ["../engine/src/ModAPI/index.ts"],
      "ModAPI/*": ["../engine/src/ModAPI/*"],
      "PreactRuntime": ["../engine/src/PreactRuntime.ts"],
      "Procedural": ["../engine/src/Procedural/index.ts"],
      "Procedural/*": ["../engine/src/Procedural/*"],
      "ProceduralAudio": ["../engine/src/ProceduralAudio/index.ts"],
      "ProceduralAudio/*": ["../engine/src/ProceduralAudio/*"],
      "Renderers": ["../engine/src/Renderers/index.ts"],
      "Renderers/*": ["../engine/src/Renderers/*"],
      "Scene": ["../engine/src/Scene.ts"],
      "Settings": ["../engine/src/Settings.ts"],
      "Systems": ["../engine/src/Systems/index.ts"],
      "Systems/*": ["../engine/src/Systems/*"],
      "UI/*": ["../engine/src/UI/*"]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "scripts/**/*.js",
    "scripts/**/*.jsx"
  ],
  "exclude": ["node_modules"]
}
