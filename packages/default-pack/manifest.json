{
  "name": "Cardboard",
  "version": "0.2.0",
  "engine": "two_5_d@0.1",
  "startScene": "scenes/scene1.json",
  "config": "config.json",
  "components": [
    {
      "name": "Position",
      "tags": ["entity"],
      "schema": {
        "type": "object",
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" }
        },
        "required": ["x", "y"]
      }
    },
    {
      "name": "Facing",
      "tags": ["entity"],
      "schema": { "type": "number" }
    },
    {
      "name": "Movement",
      "tags": ["entity"],
      "schema": {
        "type": "object",
        "properties": {
          "speed":          { "type": "number" },
          "rotationSpeed":  { "type": "number" },
          "runMultiplier":  { "type": "number" },
          "isRunning":      { "type": "boolean" },
          "z":              { "type": "number" },
          "vz":             { "type": "number" },
          "crouching":      { "type": "boolean" }
        },
        "required": ["speed", "rotationSpeed", "runMultiplier", "isRunning", "z", "vz", "crouching"]
      }
    },
    {
      "name": "PlayerInput",
      "tags": ["entity", "input"],
      "schema": {
        "type": "object",
        "properties": {
          "bindings": { "type": "object" }
        },
        "required": ["bindings"]
      }
    },
    {
      "name": "Aim",
      "tags": ["entity", "input"],
      "schema": {
        "type": "object",
        "properties": {
          "screenY": { "type": "number" }
        },
        "required": ["screenY"]
      }
    },
    {
      "name": "Camera",
      "tags": ["entity", "render"],
      "schema": {
        "type": "object",
        "properties": {
          "fov":          { "type": "number" },
          "ceiling":      { "type": "number" },
          "floor":        { "type": "number" },
          "fogDistance":  { "type": "number" },
          "maxRaySteps":  { "type": "number" },
          "cameraZ":      { "type": "number" }
        },
        "required": ["fov", "ceiling", "floor", "fogDistance", "maxRaySteps", "cameraZ"]
      }
    },
    {
      "name": "MinimapMarker",
      "tags": ["entity", "ui"],
      "schema": {
        "type": "object",
        "properties": {
          "color":          { "type": "string" },
          "radius":         { "type": "number" },
          "drawForwardRay": { "type": "boolean" }
        },
        "required": ["color", "radius", "drawForwardRay"]
      }
    },
    {
      "name": "Weapon",
      "tags": ["entity"],
      "schema": {
        "type": "object",
        "properties": {
          "lastFireTime": { "type": "number" },
          "walkPhase":    { "type": "number" },
          "wasFiring":    { "type": "boolean" },
          "reloadStart":  { "type": "number" }
        },
        "required": ["lastFireTime", "walkPhase", "wasFiring", "reloadStart"]
      }
    },
    {
      "name": "Inventory",
      "tags": ["entity"],
      "schema": {
        "type": "object",
        "properties": {
          "bag":               { "type": "array" },
          "hotbar":            { "type": "array" },
          "equipment":         { "type": "object" },
          "activeHotbarIndex": { "type": "number" }
        },
        "required": ["bag", "hotbar", "equipment", "activeHotbarIndex"]
      }
    },
    {
      "name": "Sprite",
      "tags": ["entity", "render"],
      "schema": {
        "type": "object",
        "properties": {
          "imageId":     { "type": "string" },
          "worldHeight": { "type": "number" },
          "yOffset":     { "type": "number" }
        },
        "required": ["imageId", "worldHeight", "yOffset"]
      }
    },
    {
      "name": "Animation",
      "tags": ["entity", "render"],
      "schema": {
        "type": "object",
        "properties": {
          "current":      { "type": "string" },
          "frame":        { "type": "number" },
          "elapsed":      { "type": "number" },
          "paused":       { "type": "boolean" },
          "playbackRate": { "type": "number" }
        },
        "required": ["current", "frame", "elapsed"]
      }
    },
    {
      "name": "Pickup",
      "tags": ["entity"],
      "schema": {
        "type": "object",
        "properties": {
          "itemId": { "type": "string" },
          "count":  { "type": "number" }
        },
        "required": ["itemId", "count"]
      }
    },
    {
      "name": "Light",
      "tags": ["entity", "render"],
      "schema": {
        "type": "object",
        "properties": {
          "color":     { "type": "array", "items": { "type": "number" } },
          "intensity": { "type": "number" },
          "radius":    { "type": "number" },
          "z":         { "type": "number" }
        },
        "required": ["color", "intensity", "radius"]
      }
    },
    {
      "name": "Shader",
      "tags": ["entity", "render"],
      "schema": {
        "type": "object",
        "properties": {
          "worldHooks":  { "type": "string" },
          "spriteHooks": { "type": "string" },
          "skyHooks":    { "type": "string" }
        }
      }
    },
    {
      "name": "SpawnerList",
      "tags": ["scene", "spawning"],
      "schema": {
        "type": "object",
        "properties": {
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id":     { "type": "string" },
                "x":      { "type": "number" },
                "y":      { "type": "number" },
                "facing": { "type": "number" }
              },
              "required": ["id", "x", "y", "facing"]
            }
          }
        },
        "required": ["points"]
      }
    },
    {
      "name": "Systems",
      "schema": {
        "type": "object",
        "properties": {
          "list": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "script":       { "type": "string" },
                "phase":        { "type": "string" },
                "dependencies": { "type": "array", "items": { "type": "string" } },
                "enabled":      { "type": "boolean" }
              },
              "required": ["script", "phase"]
            }
          }
        },
        "required": ["list"]
      }
    },
    {
      "name": "Scripts",
      "schema": {
        "type": "object",
        "properties": {
          "refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["refs"]
      }
    }
  ],
  "tileTextures": {
    "1": "images/tiles/wall.jpg",
    "2": "images/tiles/wood_floor.jpg",
    "3": "images/tiles/ceiling.jpg",
    "4": "images/tiles/tile_floor.jpg"
  },
  "tileSheets": [],
  "tilePresets": [
    "presets/walls.jsonc",
    "presets/floors.jsonc",
    "presets/ceilings.jsonc",
    "presets/_anonymous.jsonc"
  ],
  "items": {
    "rifle": {
      "name": "Assault Rifle",
      "image": "images/items/rifle.png",
      "type": "weapon",
      "stackMax": 1,
      "equipSlot": "mainHand",
      "weapon": {
        "fireRate": 8,
        "magazineSize": 30,
        "reloadTime": 1.5,
        "startingMag": 30,
        "ammoItem": "rifle_ammo"
      }
    },
    "rifle_ammo": {
      "name": "5.56mm Rounds",
      "image": "images/items/ammo_pack.png",
      "type": "ammo",
      "stackMax": 120,
      "worldSpriteId": "ammo_pack"
    }
  },
  "defaultInventory": [
    { "itemId": "rifle", "slot": "hotbar:0" },
    { "itemId": "rifle_ammo", "count": 90 }
  ],
  "sprites": {
    "ammo_pack": { "image": "images/items/ammo_pack.png" },
    "anim_marker": {
      "image": "images/sprites/anim_marker.png",
      "frameWidth": 32,
      "frameHeight": 32,
      "cols": 4,
      "rows": 4,
      "angles": 4,
      "animations": {
        "idle": { "frames": [0, 1, 2, 3], "frameDuration": 0.18, "loop": true }
      }
    }
  },
  "sounds": {
    "gunshot": { "file": "audio/sfx/gunshot.wav", "group": "sfx", "volume": 0.6 },
    "pickup":  { "file": "audio/sfx/pickup.wav",  "group": "sfx", "volume": 0.8 }
  },
  "_animationsSmokeTest_doc": "A1 of ANIMATIONS.md smoke test. Flip `animationsSmokeTest` to `true` and run `bun run build-packs` to enable. With the flag on, `scripts/hello.js` spawns one 'anim_marker' sprite at (4, 4) using the 4-angle × 4-frame `anim_marker` sheet — the hue shifts as the camera walks around it (exercises the angle-selection math) and the centered arrow's brightness pulses through 4 frames (exercises the AnimationSystem). Disabled by default; with the flag off the default pack renders byte-identically to pre-A1.",
  "_eventsDemo_doc": "Ev1 of EVENTS.md smoke test. When true, scripts/systems/events-demo.js subscribes to a handful of canonical engine events (scene:loaded, pack:loaded, modal:opened/closed, player:moved (once), weapon:fired) plus the default-pack's pickup:collected and console.logs each fire. Flip `eventsDemo=true` and run `bun run build-packs` to enable. Disabled by default — the events-demo script bundles either way but no-ops when the flag is off.",
  "eventsDemo": false,
  "shaders_example": {
    "_doc": "R4/S3 smoke test (wet floor via Mode 3 hooks — supersedes the S1 wet-world.frag full-shader demo). Rename this key to `shaders` and run `bun run build-packs` to enable. Default ships disabled.",
    "worldHooks": "shaders/wet-world-hooks.glsl"
  },
  "shaders_postpass_example": {
    "_doc": "R4/S4 smoke test (CRT scanlines + barrel distortion + vignette via Mode 2 post-process pass). Rename this key to `shaders` and run `bun run build-packs` to enable. Default ships disabled.",
    "postPasses": [
      { "name": "crt", "frag": "shaders/crt-pass.frag" }
    ]
  },
  "_materialsSmokeTest_doc": "M1+M2+M3 of MATERIALS.md smoke test. Flip `materialsSmokeTest` to `true` and run `bun run build-packs` to see ALL THREE tiers light up: (M1) alternate ammo pickups get a per-entity Shader pointing at shaders/ghost-sprite.glsl (translucent green wave); (M2) cells assigned the wet.floor preset in scene3 render with 85% mirror reflectivity via shaders/wet-cell.glsl; (M3) scene2.json declares shaders.worldHooks=shaders/scene-fog.glsl which adds a hot-orange depth-attenuated tint via hook_modifyFinalColor. Disabled by default — with this flag off the engine compiles its pack-default programs and rendering is byte-identical to pre-MATERIALS today, even though the wet.floor preset and scene2.json shaders block are still in the pack (they're inert until the flag flips)."
}
