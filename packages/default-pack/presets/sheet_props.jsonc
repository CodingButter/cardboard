// Sheet-derived prop presets — one per cell in manifest.tileSheets.
// Each preset references the full sheet PNG via `texture` and selects
// a single cell with `sheetCrop: { col, row }`. The resolver maps that
// to the per-cell layer the renderer cropped from the sheet at load
// (`startTileId + row * cols + col`, with the multiple_tiles sheet
// starting at tile id 10 and laid out 6 cols x 6 rows).
//
// See docs/plans/TILE_PRESETS.md § 3 for the schema.
{
  "sheet.10": {
    "texture": "images/tiles/multiple_tiles.jpg",
    "sheetCrop": { "col": 0, "row": 0 },
    "displayName": "Sheet tile 10 (col 0, row 0)",
    "tags": ["sheet"]
  },
  "sheet.11": {
    "texture": "images/tiles/multiple_tiles.jpg",
    "sheetCrop": { "col": 1, "row": 0 },
    "displayName": "Sheet tile 11 (col 1, row 0)",
