// Floor presets — default pack. Auto-generated.
// Hand-editable — keys are preset IDs, values are PresetSource records.
// See docs/plans/TILE_PRESETS.md § 3 for the schema.
{
  "tile.floor": {
    "texture": "images/tiles/tile_floor.jpg"
  },
  "tile.floor.r030.t080": {
    "extends": "tile.floor",
    "reflectiveness": 0.3,
    "transition": 0.8
  },
  "wood.floor": {
    "texture": "images/tiles/wood_floor.jpg"
  },
  // M2 of MATERIALS.md smoke test — `wet.floor` inherits the wood
  // floor texture but attaches a per-preset world shader that
  // forces 85% mirror reflectivity. Cells assigned `wet.floor` in
  // scene_heights_demo.json (smoke-test on) render as a strong
  // mirror; other wood-floor cells stay matte (variant 0).
  "wet.floor": {
    "extends": "wood.floor",
    "shader": {
      "worldHooks": "shaders/wet-cell.glsl"
    }
  }
}
